<?xml version="1.0" encoding="utf-8"?>
<!--
    可用按键值的列表请参阅 https://blog.csdn.net/mystonelxj/article/details/88184829（改成国内网站了，不会打不开）
    理论上支持大部分或所有按键值。
    目前，如果你想要控制器(手柄)输入，需要首先使用一些工具将其映射到某个按键。
    如果你搞砸了这个文件并输入了无效的按键，将使用默认值。
    如果你设法将同一个按键分配给多个功能，谁知道会发生什么？
    
    使用 VK_NOTHING (键值)表示没有分配。
    
    -->
<ent-config>
	<!-- 主要按键(快捷键)设置 -->
	<keys>
	<key function="toggle_main_menu" value="VK_F4"/>
	<!-- 开启关闭主菜单，默认按键为 F4 -->


	<key function="menu_up" value="VK_NUMPAD8"/>
	<!-- 向上移动菜单，按键为数字键盘的 8 -->
	<key function="menu_down" value="VK_NUMPAD2"/>
	<!-- 向下移动菜单，按键为数字键盘的 2 -->
	<key function="menu_left" value="VK_NUMPAD4"/>
	<!-- 向左移动菜单，按键为数字键盘的 4 -->
	<key function="menu_right" value="VK_NUMPAD6"/>
	<!-- 向右移动菜单，按键为数字键盘的 6 -->
	<key function="menu_select" value="VK_NUMPAD5"/>
	<!-- 选择菜单选项，按键为数字键盘的 5 -->
	<key function="menu_back" value="VK_NUMPAD0"/>
	<!-- 返回上一级菜单，按键为数字键盘的 0 -->


	<!-- 车辆加速、需要开启加速度  -->
	<key function="veh_boost" value="VK_NUMPAD9"/>
	<!-- 立即加速车辆，按键为 小键盘数字9 -->
	<key function="veh_stop" value="VK_NUMPAD3"/>
	<!-- 立即停止车辆，按键为 小键盘数字3 -->
	<key function="veh_rockets" value="VK_ADD"/>
	<!-- 发射车辆火箭，按键为 加号键 -->
	<key function="veh_leftblink" value="VK_LEFT"/>
	<!-- 左转向灯，按键为 左箭头键 -->
	<key function="veh_rightblink" value="VK_RIGHT"/>
	<!-- 右转向灯，按键为 右箭头键 -->
	<key function="veh_emergencyblink" value="VK_DECIMAL"/>
	<!-- 打开双闪，按键为 小数点键 -->
	<key function="veh_startrefueling" value="VK_KEY_E"/>
	<!-- 开始加油，按键为 E 键 -->
	<key function="veh_stoprefueling" value="VK_KEY_S"/>
	<!-- 停止加油，按键为 S 键 -->
	
	<key function="veh_canrefueling" value="VK_LBUTTON"/>
	<!-- 车辆加油功能，按键为 鼠标左键 -->

	<key function="toggle_airbrake" value="VK_F6"/>
	<!-- 开启/关闭，自由移动功能，按键为 F6 -->


	<key function="airbrake_up" value="VK_KEY_Q"/>
	<!-- 自由移动，上升，按键为 Q -->
	<key function="airbrake_down" value="VK_KEY_Z"/>
	<!-- 自由移动，下降，按键为 Z -->
	<key function="airbrake_forward" value="VK_KEY_W"/>
	<!-- 自由移动，前进，按键为 W -->
	<key function="airbrake_back" value="VK_KEY_S"/>
	<!-- 自由移动，后退，按键为 S -->
	<key function="airbrake_rotate_left" value="VK_KEY_A"/>
	<!-- 自由移动，左转，按键为 A -->
	<key function="airbrake_rotate_right" value="VK_KEY_D"/>
	<!-- 自由移动，右转，按键为 D -->
	<key function="airbrake_move_aside" value="VK_SPACE"/>
	<!-- 自由移动，侧移，按键为空格键 -->
	<key function="airbrake_mouse_control" value="VK_KEY_M"/>
	<!-- 自由移动，鼠标控制，按键为 M -->
	<key function="airbrake_speed" value="VK_SHIFT"/>
	<!-- 自由移动，加速，按键为 Shift -->
	<key function="airbrake_freeze_time" value="VK_KEY_T"/>
	<!-- 自由移动，冻结时间，按键为 T -->
	<key function="airbrake_help" value="VK_KEY_H"/>
	<!-- 自由移动，隐藏帮助，按键为 H -->


	<key function="objectplacer_up" value="VK_KEY_Q"/>
	<!-- 物体摆放，上升，按键为 Q -->
	<key function="objectplacer_down" value="VK_KEY_Z"/>
	<!-- 物体摆放，下降，按键为 Z -->
	<key function="objectplacer_forward" value="VK_KEY_W"/>
	<!-- 物体摆放，前进，按键为 W -->
	<key function="objectplacer_back" value="VK_KEY_S"/>
	<!-- 物体摆放，后退，按键为 S -->
	<key function="objectplacer_rotate_left" value="VK_KEY_A"/>
	<!-- 物体摆放，左旋转，按键为 A -->
	<key function="objectplacer_rotate_right" value="VK_KEY_D"/>
	<!-- 物体摆放，右旋转，按键为 D -->
	<key function="objectplacer_speed_up" value="VK_OEM_6"/>
	<!-- 物体放置，加速，按键为   ]   -->
	<key function="objectplacer_speed_down" value="VK_OEM_4"/>
	<!-- 物体放置，减速，按键为   [   -->
	<key function="objectplacer_freeze_time" value="VK_KEY_T"/>
	<!-- 物体摆放，冻结时间，按键为 T -->
	<key function="objectplacer_freeze_position" value="VK_KEY_G"/>
	<!-- 物体摆放，切换物体退出时的冻结状态 G -->
	<key function="objectplacer_help" value="VK_KEY_H"/>
	<!-- 物体摆放，隐藏按键说明，按键为 H -->


	<!-- 以下是快捷键设置，值为 VK_NOTHING 表示空值，值为[false 禁用]对应的组合键，值为[true 启用]对应的组合键  -->
	<!-- [hotkey_1]  至 [hotkey_9] 对应游戏里快捷键，编号1到9。你不能改变 [function] 的值 -->
	<!-- 你可以改变 'value' 和 'modCtrl'， 'modAlt'， 'modShift'的值。-->
	<!-- 你可以使用任何组合，例如 [CTRL + ALT + SHIFT+F1] 更改后：[ value="VK_F1" modCtrl="true" modAlt="true" modShift="true" ] -->
	<!-- 或者你也可以不使用组合，例如 F2 [ value="VK_F2" modCtrl="false" modAlt="false" modShift="false" ] -->
	<key function="hotkey_1" value="VK_F5" modCtrl="false" modAlt="false" modShift="false"/>
	<key function="hotkey_2" value="VK_NOTHING" modCtrl="false" modAlt="false" modShift="false"/>
	<key function="hotkey_3" value="VK_NOTHING" modCtrl="false" modAlt="false" modShift="false"/>
	<key function="hotkey_4" value="VK_NOTHING" modCtrl="false" modAlt="false" modShift="false"/>
	<key function="hotkey_5" value="VK_NOTHING" modCtrl="false" modAlt="false" modShift="false"/>
	<key function="hotkey_6" value="VK_NOTHING" modCtrl="false" modAlt="false" modShift="false"/>
	<key function="hotkey_7" value="VK_NOTHING" modCtrl="false" modAlt="false" modShift="false"/>
	<key function="hotkey_8" value="VK_NOTHING" modCtrl="false" modAlt="false" modShift="false"/>
	<key function="hotkey_9" value="VK_NOTHING" modCtrl="false" modAlt="false" modShift="false"/>
	</keys>

